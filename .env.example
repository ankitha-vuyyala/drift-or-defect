# Copy to .env and fill in. Never commit .env. The runner passes these to jobs; nothing prints them.
# Only needed for the LLM diagnostic-agent baseline. No paid calls happen until a budget is approved.
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Local models (free). Default Ollama address:
OLLAMA_HOST=http://localhost:11434
# Optional: Kaggle API token, only if a dataset must come from Kaggle
KAGGLE_USERNAME=
KAGGLE_KEY=
